<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 3: wake-word engine needs continuous mic access via a
         foreground service. Declared now so the permission model is
         visible from day one, even though the service is a stub. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <!-- android:icon and android:theme intentionally omitted —
             no launcher icon or theme resources exist yet. Add both
             during the branding pass (see handoff doc, Section 1). -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 3 — unimplemented, see CaptureForegroundService.kt -->
        <service
            android:name=".service.CaptureForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

    </application>

</manifest>
